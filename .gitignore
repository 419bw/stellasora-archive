/site/

# 本地私有笔记与解密工具（严格本地保留，绝不提交至公开仓库）
local_secrets/
*.local.*
*.secret.*

# wiki 用语集翻译：已独立为私有仓库 stellasora-wiki-translation（嵌套 git 仓库，不入库）
wiki_translation/

# 多 agent 协作的历史任务记录（本地保留，不入库）
.agents/

